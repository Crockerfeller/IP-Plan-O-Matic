{
  // Type-checks app.js (plain JavaScript, with JSDoc hints where inference needs help). Nothing is compiled:
  // `npm run typecheck` only reports errors, and CI runs it on every push.
  // strictNullChecks and noImplicitAny are off: turning them on means annotating most of the file.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "files": ["app.js"]
}
